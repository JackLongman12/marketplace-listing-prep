<?xml version="1.0" encoding="utf-8"?>
<!--
  Network allowlist. The app trusts NO certificate authorities by default, so every HTTPS
  connection fails, including background telemetry from bundled libraries (e.g. ML Kit
  usage stats to Google). The only exceptions are Hugging Face hosts, used solely for the
  one-time model download from huggingface.co and its CDN hosts under hf.co (no account or
  token is sent; the file must match Google's published SHA-256).
  Barcode lookup (only when the AI can't identify an item, can be turned off in Settings):
  api.upcitemdb.com, world.openfoodfacts.org and openlibrary.org receive the barcode number only.
  Google AI (only with your own key): generativelanguage.googleapis.com. Price search sends
  the title, condition and location (never photos).
  App updates: api.github.com, github.com and GitHub's download hosts (release files only).
  Plain HTTP is disabled everywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">hf.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.upcitemdb.com</domain>
        <domain includeSubdomains="false">world.openfoodfacts.org</domain>
        <domain includeSubdomains="false">openlibrary.org</domain>
        <domain includeSubdomains="false">api.github.com</domain>
        <domain includeSubdomains="false">generativelanguage.googleapis.com</domain>
        <domain includeSubdomains="false">github.com</domain>
        <domain includeSubdomains="false">objects.githubusercontent.com</domain>
        <domain includeSubdomains="false">release-assets.githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
